# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议）───
# 不想启用 AI 解读可以不填；只排盘、看命盘不需要任何 Key。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ─── 其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── Upstash Redis（公网部署必填）───
# Vercel 上用于限流与缓存；本地不填会退回进程内缓存。
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── 成本控制 ───
AI_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_DAY=100
AI_RATE_LIMIT_PER_CHART_DAY=30
AI_DAILY_REQUEST_CAP=2000

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
